{
  "compilerOptions": {
    "outDir": "./build/",
    "rootDir": "./src",
    "target": "es2021",
    "module": "esnext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true, // @nimiq/core types are incompatible with the typed array generics of TypeScript >= 5.7
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "./dist/src/",
    "lib": [
      "es2021",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "src/*.ts",
    "types/ErrorContainer.d.ts",
    "types/MessagePrefix.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
