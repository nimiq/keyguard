{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "ES2021"],
    "module": "CommonJS",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["jasmine"], // TypeScript >= 6 doesn't auto-include @types packages anymore.
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "types/*",
    "src/**/*.js",
    "src/**/*.mjs",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "karma.conf.js",
    "demos",
    "instrumented",
    "coverage",
    "src/lib/QrScannerWorker.js",
    "src/lib/bitcoin/BitcoinJS.js",
    "src/service-worker", // Service worker is checked with a separate tsconfig in src/service-worker
    "src/translations/index.js"
  ]
}
