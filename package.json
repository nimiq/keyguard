{
  "name": "keyguard",
  "version": "1.0.0",
  "description": "Secure storage for Nimiq private keys.",
  "scripts": {
    "pre": "yarn i18n:build-dictionary && test -e src/lib/bitcoin/BitcoinJS.js || yarn build:bitcoinjs",
    "serve": "yarn pre && node serve.js",
    "build": "yarn pre && tools/build.sh",
    "build:bitcoinjs": "esbuild tools/bitcoinjs-parts.js --bundle --format=iife --global-name=BitcoinJS --platform=browser --target=es2021 --minify --sourcemap --log-level=warning --outfile=src/lib/bitcoin/BitcoinJS.js",
    "test": "karma start",
    "typecheck": "tsc && tsc -p src/service-worker/tsconfig.json",
    "lint": "yarn i18n:build-dictionary && eslint src tools .github/scripts && if ( grep 'fit\\|fdescribe' tests/lib/* ); then exit 1; else exit 0; fi",
    "lintfix": "eslint --fix src tools .github/scripts",
    "checkdeps": "node tools/dependencyValidator.js",
    "checklangs": "yarn i18n:build-dictionary && node tools/translationValidator.js",
    "checkdist": "node tools/distValidator.js",
    "checkdeployment": "node tools/deploymentValidator.js",
    "pr": "yarn typecheck && yarn lint && yarn test && yarn checkdeps && yarn checklangs && yarn build testnet && yarn checkdist testnet && cd client && yarn lint && yarn build",
    "watch": "tsc-watch --pretty --onSuccess \"yarn lint\"",
    "watchfix": "tsc-watch --pretty --onSuccess \"yarn lintfix\"",
    "postinstall": "patch-package && cd client && yarn",
    "i18n:build-dictionary": "tools/i18n.sh",
    "i18n:pull": "tx pull --all --force --mode sourceastranslation",
    "i18n:push": "tx push --source",
    "i18n:sync": "yarn i18n:push && yarn i18n:pull"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimiq/keyguard.git"
  },
  "keywords": [
    "Nimiq",
    "Keyguard"
  ],
  "author": "Nimiq",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nimiq/keyguard/issues"
  },
  "homepage": "https://github.com/nimiq/keyguard#readme",
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@nimiq/core": "https://pkg.pr.new/@nimiq/core@fd02762",
    "@nimiq/core-web": "1.6.3",
    "@nimiq/rpc": "^0.3.0",
    "@nimiq/style": "^0.8.3",
    "@types/jasmine": "^2.8.8",
    "bip32": "5.0.1",
    "bitcoinjs-lib": "7.0.5",
    "ecpair": "3.0.2",
    "esbuild": "0.28.2",
    "eslint": "^5.0.1",
    "eslint-config-airbnb-base": "^13.1.0",
    "eslint-plugin-import": "^2.13.0",
    "eslint-plugin-require-jsdoc-except": "^1.1.0",
    "ethers": "^5.7.2",
    "jasmine-core": "^3.1.0",
    "karma": "^6.3.16",
    "karma-chrome-launcher": "^2.2.0",
    "karma-firefox-launcher": "^1.1.0",
    "karma-istanbuljs-reporter": "^0.2.0",
    "karma-jasmine": "^1.1.2",
    "patch-package": "^8.0.1",
    "tsc-watch": "^1.0.22",
    "typescript": "6.0"
  }
}
